# ─── READ-ONLY MySQL (office mdpf) ─────────────────────────────────────
# Gateway only ever issues SELECT against these credentials. Requires a
# dedicated SELECT-only account; the gateway never creates/alters it.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=ems_gateway
MYSQL_PASSWORD=change_me
MYSQL_DATABASE=mdpf

# ─── Local MySQL buffer (gateway's own state) ───────────────────────
# All gateway state (staged events, snapshots, normalized values, history,
# findings, summaries) lives here. This is a SEPARATE database from the
# office mdpf database above, with its own account: the gateway never writes
# to the office database. Create it with:
#   CREATE DATABASE gateway_buffer CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'gateway_buf'@'localhost' IDENTIFIED BY '<password>';
#   GRANT ALL PRIVILEGES ON gateway_buffer.* TO 'gateway_buf'@'localhost';
BUFFER_MYSQL_HOST=127.0.0.1
BUFFER_MYSQL_PORT=3306
BUFFER_MYSQL_USER=gateway_buf
BUFFER_MYSQL_PASSWORD=change_me
BUFFER_MYSQL_DATABASE=gateway_buffer

# ─── EMS identity sync (read-only) ─────────────────────────────────
# Lets the AI assistant resolve EMS accounts live from the ems-backend
# database, so per-role scoping always matches reality: ADMIN/TECHNICIAN see
# the whole estate, USER sees only the meters in consumer_meters (plus
# users.logger_id). Needs exactly two SELECT grants:
#   GRANT SELECT ON mdpf.users TO 'gateway_buf'@'localhost';
#   GRANT SELECT ON mdpf.consumer_meters TO 'gateway_buf'@'localhost';
# Leave EMS_MYSQL_HOST empty to disable the sync (manual AI_PRINCIPALS only).
EMS_MYSQL_HOST=127.0.0.1
EMS_MYSQL_PORT=3306
EMS_MYSQL_USER=gateway_buf
EMS_MYSQL_PASSWORD=change_me
EMS_MYSQL_DATABASE=mdpf
EMS_SYNC_TTL_SECONDS=60

# ─── Modbus TCP server bind ────────────────────────────────────────────
# Port 502 is reserved/blocked on Windows; 1502 is the working default.
MODBUS_BIND_HOST=0.0.0.0
MODBUS_BIND_PORT=1502

# ─── BACnet/IP server bind ─────────────────────────────────────────────
# 47808 is the standard BACnet/IP port.
BACNET_BIND_IP=0.0.0.0
BACNET_BIND_PORT=47808
BACNET_DEVICE_INSTANCE=1001

# ─── Health monitor HTTP endpoint ───────────────────────────────────────
# Loopback only: contains no secrets but no need to expose it.
HEALTH_BIND_HOST=127.0.0.1
HEALTH_BIND_PORT=9090

# ─── AI assistant (Amazon Bedrock) ─────────────────────────────────────
# Disabled unless you set AI_ENABLED=true. Off means: no AWS calls, no
# extra port, gateway behaves exactly as before.
AI_ENABLED=false

# Bind 0.0.0.0 only if you also set a strong AI_BEARER_TOKEN (>= 32 chars).
# The gateway refuses to start otherwise.
AI_BIND_HOST=127.0.0.1
AI_BIND_PORT=9091

# Generate your own, e.g. in PowerShell:
#   python -c "import secrets; print(secrets.token_urlsafe(36))"
AI_BEARER_TOKEN=

# ── Per-role access (recommended over the single token above) ────────────
# One line per caller, so every question can be attributed to a person and a
# consumer only ever sees their own meters:
#
#   <subject>:<role>:<comma-separated-meter-ids|*>:<token>
#
#   subject  stable id - use the ems-backend users.id
#   role     ADMIN | TECHNICIAN | USER  (an unknown role becomes USER)
#   meters   meter ids this caller owns, or * for "no restriction"
#   token    >= 32 characters, generated separately per person
#
# ADMIN and TECHNICIAN may use * (whole estate). USER is always scoped: on a
# USER line "*" is treated as NO meters, so a typo cannot expose the estate.
# When this is set it takes precedence over AI_BEARER_TOKEN.
#
# Example:
# AI_PRINCIPALS=ops:ADMIN:*:<token1>;maria:USER:026026060003:<token2>
AI_PRINCIPALS=

AI_MAX_TOOL_HOPS=5
AI_TIMEOUT_SECONDS=30
AI_RATE_LIMIT_PER_MIN=10

# Used by the phase-4 daily summary / anomaly reports.
AI_SUMMARY_LOCAL_TIME=08:00
AI_ANOMALY_COOLDOWN_MIN=60
# Phase 4 anomaly thresholds. These are plain comparisons against the readings;
# no AWS call is made to decide whether a finding fires.
# A totalizer that gains more than this in one hour is flagged as a possible
# leak or burst. Raise it if your site legitimately has high overnight draw.
AI_LEAK_M3_PER_HOUR=5.0
# Battery at or below this volts is flagged for replacement.
AI_BATTERY_LOW_VOLTS=3.4
# Signal at or below this dBm is flagged as weak (-100 is poor, -120 unusable).
AI_SIGNAL_WEAK_DBM=-100
# How many days of hourly history to keep.
AI_HISTORY_RETENTION_DAYS=90

# ─── AWS / Bedrock ────────────────────────────────────────────────────
# Amazon Nova Pro. Check the model's regional availability for your region;
# do not guess a region. ap-southeast-2 (Sydney) is the verified default.
AWS_REGION=ap-southeast-2
BEDROCK_MODEL_ID=amazon.nova-pro-v1:0

# Programmatic IAM access keys for a dedicated user that may ONLY invoke
# bedrock:Converse on the model above. Never commit real values; .env is
# already gitignored.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── oBIX (NeoView / Niagara 4) ───────────────────────────────────────
# NeoView ships with a Niagara 4 licence, which exposes an oBIX interface at
# /obix. This is the integration path for reading meter points from NeoView and
# writing AI results back into it.
#
# Leave OBIX_BASE_URL empty to keep the integration switched off.
# Typical value: https://<neoview-host>/obix
OBIX_BASE_URL=

# Authentication scheme:
#   auto  - send Basic credentials and fall back to the Niagara SCRAM login on 401
#   basic - Basic only
#   scram - Niagara 4 web login (SCRAM-SHA-512); the endpoint requires TLS
OBIX_AUTH=auto
# A dedicated Niagara account with read access to the meter folder and write
# access to the insights folder. Prefer a service account over a personal login.
OBIX_USERNAME=
OBIX_PASSWORD=
OBIX_TIMEOUT_SECONDS=10
# Keep true in production. Only false for a self-signed lab certificate.
OBIX_VERIFY_TLS=true
# Explicit NeoView <-> gateway point map. When this file defines a non-empty
# read/write block it takes precedence over the two folder settings below.
# Copy config/obix.yaml and fill in the hrefs (use scripts/obix_points.py to
# list them). Niagara encodes spaces as $20 etc. in the final path segment.
OBIX_POINT_MAP=config/obix.yaml
# The oBIX tree is slower than the poll loop; reads run on this interval
# (seconds) instead of every extraction cycle.
OBIX_POLL_INTERVAL_SECONDS=60
# How often to re-read the station's point facets (min/max/precision/unit) over
# oBIX, in hours. 0 disables the automatic refresh; the cache written by
# scripts/probe_facets.py is still used at startup either way.
OBIX_FACETS_REFRESH_HOURS=24
# Folder layout fallback, relative to OBIX_BASE_URL (used only when the point
# map above has an empty read block). One subfolder per meter id.
OBIX_METER_ROOT=
# Folder we publish AI findings into. Must exist and be writable by the
# account above; create it in NeoView before enabling writes.
OBIX_INSIGHTS_ROOT=

# Separate MySQL database for the NeoView oBIX points (catalog + latest values
# + hourly history). Host/port/user/password default to BUFFER_MYSQL_*; leave
# OBIX_MYSQL_DATABASE empty to switch the oBIX database off.
OBIX_MYSQL_DATABASE=obix
OBIX_MYSQL_HOST=
OBIX_MYSQL_PORT=0
OBIX_MYSQL_USER=
OBIX_MYSQL_PASSWORD=
